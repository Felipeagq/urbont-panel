# ─────────────────────────────────────────────────────────────────────────────
# URBONT PANEL v2 — variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env.local para desarrollo. En AWS Amplify se definen en:
#   App settings → Environment variables
# ─────────────────────────────────────────────────────────────────────────────

# URL del backend Urbont al que el panel hace proxy.
# SOLO servidor: no lleva prefijo NEXT_PUBLIC_, así nunca llega al bundle del
# navegador. La usa src/app/api/[...path]/route.ts.
#
#   local       → http://localhost:5001
#   producción  → https://app.urbont.com   (verificado: api.urbont.com no resuelve)
BACKEND_API_URL=http://localhost:5001

# ─────────────────────────────────────────────────────────────────────────────
# Módulo Financiero (/financiero)
# ─────────────────────────────────────────────────────────────────────────────
# Los valores reales van SÓLO en .env.local (ignorado por git) o en las variables
# de entorno de Amplify. Este archivo se versiona: nunca poner secretos acá.

# AWS Cost Explorer — usuario IAM dedicado, sólo lectura de billing
# (ce:GetCostAndUsage, ce:GetCostForecast, ce:GetDimensionValues).
# No reutilizar las credenciales de servicio de S3/SQS: Cost Explorer expone la
# facturación completa de la cuenta.
FOMO_AWS_COST_EXPLORER_KEY_ID=AKIAXXXXXXXXXXXXXXXX
FOMO_AWS_COST_EXPLORER_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio — Usage Records viene activo por defecto, no hay que habilitar nada.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx